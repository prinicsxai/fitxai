# ========================================================
# FITXAI - Entorno de Producción (production.env)
# ========================================================
# NOTA: NUNCA introducir contraseñas ni claves reales en repositorios.
# Estas variables deben definirse en el orquestador (Kubernetes, AWS ECS, Docker Swarm o Vault).
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_NAME=FITXAI-Enterprise
API_PREFIX=/api/v1

# Seguridad & Secretos (Claves de mínimo 64 caracteres de alta entropía)
JWT_SECRET=REPLACE_WITH_PRODUCTION_VAULT_GENERATED_KEY_MIN_64_CHARS
JWT_EXPIRATION=4h
CORS_ORIGIN=https://app.fitxai.com,https://panel.fitxai.com
TRUST_PROXY=1
SECURE_COOKIES=true

# Base de datos PostgreSQL Producción (SSL obligatorio)
DATABASE_URL=postgresql://USER:PASSWORD@prod-db-cluster.internal:5432/fitxai_prod?schema=public&sslmode=verify-full

# Rate Limiting de Producción (Protección DoS y abuso de endpoints)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Geolocalización & Fichajes
MAX_GPS_ACCURACY_METERS=100
ALLOW_MOCK_LOCATIONS=false
REQUIRE_EXACT_LOCATION=true
