# ========================================================
# FITXAI - Entorno de Staging (staging.env)
# ========================================================
NODE_ENV=staging
PORT=4000
HOST=0.0.0.0
APP_NAME=FITXAI-Staging
API_PREFIX=/api/v1

# Seguridad & Secretos (deben inyectarse mediante CI/CD o Secrets Manager)
JWT_SECRET=replace-with-cryptographic-secret-in-staging-ci-vault
JWT_EXPIRATION=8h
CORS_ORIGIN=https://staging.fitxai.com,https://staging-app.fitxai.com

# Base de datos PostgreSQL Staging
DATABASE_URL=postgresql://fitxai_staging_user:STAGING_STRONG_PASSWORD@staging-db.fitxai.internal:5432/fitxai_staging?schema=public&sslmode=require

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Geolocalización & Fichajes
MAX_GPS_ACCURACY_METERS=100
ALLOW_MOCK_LOCATIONS=false
REQUIRE_EXACT_LOCATION=true
