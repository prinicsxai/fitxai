# ========================================================
# FITXAI - Entorno de Desarrollo (development.env)
# ========================================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=FITXAI-Development
API_PREFIX=/api/v1

# Seguridad & Secretos
JWT_SECRET=super-secret-dev-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRATION=8h
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:19006,exp://192.168.1.100:8081

# Base de datos PostgreSQL
DATABASE_URL=postgresql://dpeixotoc@localhost:5432/fitxai_dev?schema=public

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Geolocalización & Fichajes
MAX_GPS_ACCURACY_METERS=150
ALLOW_MOCK_LOCATIONS=false
REQUIRE_EXACT_LOCATION=true
