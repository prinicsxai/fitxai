# ========================================================
# FITXAI - Variables de Entorno de Ejemplo (.env.example)
# Copiar este archivo a .env para desarrollo local:
#   cp .env.example .env
# ========================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=FITXAI

# Seguridad
JWT_SECRET=development-secret-key-at-least-32-chars-long-example
JWT_EXPIRATION=8h
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:19006,http://localhost:8081

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://dpeixotoc@localhost:5432/fitxai_dev?schema=public

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Geolocalización puntual
MAX_GPS_ACCURACY_METERS=150
ALLOW_MOCK_LOCATIONS=false
REQUIRE_EXACT_LOCATION=true
